# Port to run the server on
PORT=3000

# Firebase service account JSON (alternative to placing firebase-service-account.json file)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# RevenueCat secret API key (starts with sk_)
# Required for server-side entitlement verification
# Get it from: RevenueCat Dashboard > Project > API Keys > Secret API Key
REVENUECAT_SECRET_KEY=sk_your_secret_key_here

# Optional: RevenueCat webhook authorization token
# Set this to match the Authorization header configured in RC dashboard
# REVENUECAT_WEBHOOK_AUTH=your_webhook_auth_token_here
